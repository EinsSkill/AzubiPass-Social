              "text": "Beobachtung beschreiben",
              "position": 1
            },
            {
              "text": "Wirkung auf mich schildern",
              "position": 2
            },
            {
              "text": "Wunsch oder Vorschlag äußern",
              "position": 3
            }
          ]
        }
      ],
      "bewertung": {
        "art": "automatisch",
        "punkte_je_treffer": 1
      },
      "erklaerung": "Konstruktives Feedback: Beobachtung, Wirkung, Wunsch.",
      "quelle": "ik2024-lf02-k04, Abschnitt a2"
    },
    {
      "id": "ik2024-lf02-k04-04",
      "operator": "Berechnen Sie",
      "anforderungsbereich": 2,
      "punkte": 3,
      "dauer_min": 3,
      "schwierigkeit": 2,
      "passt_zu": [],
