              ],
              [
                "Lageplan von Studio, Lager und Verwaltung",
                "Muss",
                "ja"
              ],
              [
                "Ansprechpartnerliste mit dienstlichen Kontakten",
                "Muss",
                "ja"
              ],
              [
                "Freigabe der Arbeitsschutzunterweisung",
                "Muss",
                "nein"
              ],
              [
                "Englische Kurzfassung",
                "Kann",
                "ja"
              ]
            ]
          }
        }
      ],
      "eingabe": [
        {
          "block": "textfeld",
          "frage": "Beurteilen Sie, ob das Projektergebnis abgenommen werden kann, und schlagen Sie ein Vorgehen vor.",
          "zeilen": 5
        }
      ],
      "bewertung": {
        "art": "selbstbewertung",
        "musterloesung": "Eine erfolgreiche Abnahme ist nicht möglich, weil das Muss-Kriterium ‚Freigabe der Arbeitsschutzunterweisung‘ nicht erfüllt ist. Dass vier von fünf Kriterien — darunter ein Kann-Kriterium — erfüllt sind, ändert daran nichts. Vorschlag: Abnahme mit Auflage, die Freigabe bis zu einem festen Termin (vor dem nächsten Einstellungstermin) nachzuholen, oder Nachbesserung und erneute Vorlage.",
        "raster": [
          {
            "kriterium": "Fehlendes Muss-Kriterium als entscheidend erkannt",
            "punkte": 1
          },
          {
            "kriterium": "Prozentsatz erfüllter Kriterien nicht als Maßstab verwendet",
            "punkte": 1
          },
          {
            "kriterium": "Sachgerechtes Vorgehen (Auflage mit Termin oder Nachbesserung)",
            "punkte": 1
          }
        ]
      },
      "erklaerung": "Muss-Kriterien sind zwingend; ein verfehltes Muss-Kriterium verhindert die erfolgreiche Abnahme.",
      "quelle": "ik2024-lf02-k04, Abschnitt a3"
    },
    {
      "id": "ik2024-lf02-k04-02",
      "operator": "Formulieren Sie",
      "anforderungsbereich": 3,
      "punkte": 3,
      "dauer_min": 4,
      "schwierigkeit": 2,
      "passt_zu": [],
      "variablen": null,
      "anzeige": [
        {
          "block": "text",
          "inhalt": "In der Abschlussbesprechung des MAKEL-Onboarding-Projekts fällt der Satz: „Das Team hat schlecht kommuniziert.“ Bekannt ist: Freigaben der Abteilungen fehlten am Ende, weil im Aufgabenplan niemand für sie eingetragen war."
        }
      ],
      "eingabe": [
        {
          "block": "textfeld",
          "frage": "Formulieren Sie daraus eine verwertbare Erkenntnis für Folgeprojekte.",
          "zeilen": 4
        }
      ],
      "bewertung": {
        "art": "selbstbewertung",
        "musterloesung": "„Freigaben fehlten im gemeinsamen Aufgabenplan, weil keine Person dafür verantwortlich war. Künftig wird für jedes Arbeitspaket eine verantwortliche Person und ein dokumentierter Freigabetermin festgelegt.“",
        "raster": [
          {
            "kriterium": "Konkretes Problem statt Pauschalurteil",
            "punkte": 1
          },
          {
            "kriterium": "Ursache benannt",
            "punkte": 1
          },
          {
            "kriterium": "Konkrete Maßnahme für künftige Projekte",
            "punkte": 1
          }
        ]
      },
      "erklaerung": "Verwertbare Erkenntnisse nennen Ursache und Maßnahme und werden für Folgeprojekte festgehalten.",
      "quelle": "ik2024-lf02-k04, Abschnitt a4"
    },
    {
      "id": "ik2024-lf02-k04-03",
      "operator": "Nennen Sie",
      "anforderungsbereich": 1,
      "punkte": 3,
      "dauer_min": 2,
      "schwierigkeit": 1,
      "passt_zu": [],
      "variablen": null,
      "anzeige": [
