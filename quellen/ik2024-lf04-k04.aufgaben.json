{
  "lernfeld": "ik2024-lf04",
  "kapitel": "k04",
  "verweise_im_klausurmodus": "ausblenden",
  "bausteine": [
    {
      "id": "ik2024-lf04-k04-01",
      "operator": "Berechnen Sie",
      "anforderungsbereich": 2,
      "punkte": 4,
      "dauer_min": 5,
      "schwierigkeit": 2,
      "passt_zu": [],
      "variablen": {
        "lep": {
          "von": 800,
          "bis": 1400,
          "schritt": 100
        },
        "rabatt": {
          "von": 5,
          "bis": 15,
          "schritt": 5
        },
        "skonto": {
          "von": 2,
          "bis": 3,
          "schritt": 1
        },
        "fracht": {
          "von": 20,
          "bis": 60,
          "schritt": 10
        }
      },
      "abgeleitet": {
        "zep": "lep * (1 - rabatt / 100)",
        "bezug": "runde(zep * (1 - skonto / 100) + fracht, 2)"
      },
      "anzeige": [
        {
          "block": "text",
          "inhalt": "Ein Lieferant bietet der MAKEL Studio GmbH 100 Hoodie-Rohlinge zu einem Listenpreis von {lep} € netto an. Er gewährt {rabatt} % Rabatt und bei Zahlung innerhalb von 10 Tagen {skonto} % Skonto auf den rabattierten Warenwert. Für Fracht berechnet er {fracht} €, die weder rabattiert noch skontiert werden. MAKEL zahlt innerhalb der Skontofrist. Berechnen Sie Zieleinkaufspreis und Bezugspreis."
        }
      ],
      "eingabe": [
        {
          "block": "zahl",
          "label": "Zieleinkaufspreis",
          "einheit": "€",
          "loesung": "zep",
          "toleranz": 0.01,
          "punkte": 1
        },
        {
          "block": "zahl",
          "label": "Bezugspreis",
          "einheit": "€",
          "loesung": "bezug",
          "toleranz": 0.01,
          "punkte": 3,
          "folgefehler_aus": [
            "zep"
          ]
        }
      ],
      "bewertung": {
        "art": "automatisch",
        "punkte_gesamt": 4
      },
      "erklaerung": "Listenpreis − Rabatt = Zieleinkaufspreis; − Skonto (auf den Zielpreis) = Bareinkaufspreis; + Bezugskosten = Bezugspreis.",
      "quelle": "ik2024-lf04-k04, Abschnitt a2"
    },
    {
      "id": "ik2024-lf04-k04-02",
      "operator": "Berechnen Sie",
      "anforderungsbereich": 1,
      "punkte": 2,
      "dauer_min": 2,
      "schwierigkeit": 1,
      "passt_zu": [],
      "variablen": {
        "usd": {
          "von": 2200,
          "bis": 8800,
          "schritt": 1100
        }
      },
      "abgeleitet": {
        "eur": "runde(usd / 1.1, 2)"
      },
      "anzeige": [
        {
          "block": "text",
          "inhalt": "Ein Hersteller außerhalb der EU bietet der MAKEL Studio GmbH Rohlinge für {usd} USD an. Für die Aufgabe gilt der Kurs 1 € = 1,10 USD. Weitere Kosten bleiben unberücksichtigt. Rechnen Sie den Angebotspreis in Euro um."
        }
      ],
      "eingabe": [
        {
          "block": "zahl",
          "label": "Angebotspreis",
          "einheit": "€",
          "loesung": "eur",
          "toleranz": 0.01
        }
      ],
      "bewertung": {
        "art": "automatisch",
        "punkte_gesamt": 2
      },
      "erklaerung": "Mengennotierung: 1 € = 1,10 USD. Euro-Betrag = Dollar-Betrag ÷ 1,10.",
      "quelle": "ik2024-lf04-k04, Abschnitt a3"
    },
    {
      "id": "ik2024-lf04-k04-03",
